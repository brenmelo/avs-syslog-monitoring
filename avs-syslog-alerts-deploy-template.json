{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the scheduled query rules. Must match the Log Analytics workspace region. Defaults to the resource group location."
      }
    },
    "workspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics workspace that contains AVSSyslog.",
        "strongType": "Microsoft.OperationalInsights/workspaces"
      }
    },
    "alertNamePrefix": {
      "type": "string",
      "defaultValue": "AVS",
      "metadata": {
        "description": "Prefix added to all alert rule names."
      }
    },
    "actionGroupIdSev0": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Action group for Sev 0 alerts (Emergency, Alert, Host-down, Heartbeat).",
        "strongType": "Microsoft.Insights/actionGroups"
      }
    },
    "actionGroupIdSev1": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Action group for Sev 1 alerts (Critical, VM, DNS, Role changes).",
        "strongType": "Microsoft.Insights/actionGroups"
      }
    },
    "actionGroupIdSev2": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Action group for Sev 2 alerts (Error, DFW, Maintenance, Guest Reboot).",
        "strongType": "Microsoft.Insights/actionGroups"
      }
    },
    "errThresholdPer15m": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 1,
      "metadata": {
        "description": "Threshold for Severity 3 err/error alert (per HostName+AppName in 15 minutes)."
      }
    },
    "dnsFailureThresholdPer15m": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1,
      "metadata": {
        "description": "Threshold for DNS failure alert (per HostName in 15 minutes)."
      }
    },
    "dfwSpikeThresholdPer15m": {
      "type": "int",
      "defaultValue": 50,
      "minValue": 1,
      "metadata": {
        "description": "Threshold for distributed firewall blocked traffic spike alert (per HostName in 15 minutes)."
      }
    },
    "deploySev0Emergency": {
      "type": "bool",
      "defaultValue": true
    },
    "deploySev0Alert": {
      "type": "bool",
      "defaultValue": true
    },
    "deploySev1Critical": {
      "type": "bool",
      "defaultValue": true
    },
    "deploySev2Error": {
      "type": "bool",
      "defaultValue": false
    },
    "deployHostConnectionLost": {
      "type": "bool",
      "defaultValue": true
    },
    "deployHostShutdown": {
      "type": "bool",
      "defaultValue": true
    },
    "deployVmDisconnected": {
      "type": "bool",
      "defaultValue": true
    },
    "deployVmRemovedFromInventory": {
      "type": "bool",
      "defaultValue": true
    },
    "deployVmGuestReboot": {
      "type": "bool",
      "defaultValue": true
    },
    "deployDnsFailures": {
      "type": "bool",
      "defaultValue": true
    },
    "deployDfwSpike": {
      "type": "bool",
      "defaultValue": true
    },
    "deployHostMaintenanceMode": {
      "type": "bool",
      "defaultValue": true
    },
    "deployRolePermissionChanges": {
      "type": "bool",
      "defaultValue": true
    },
    "deployNsxFailureDomainDown": {
      "type": "bool",
      "defaultValue": true
    },
    "deployNsxEamServiceDown": {
      "type": "bool",
      "defaultValue": true
    },
    "deployHostSudoExpiredCredential": {
      "type": "bool",
      "defaultValue": true
    },
    "deploySyslogIngestionHeartbeat": {
      "type": "bool",
      "defaultValue": true
    }
  },
  "variables": {
    "actionGroupsSev0": "[if(empty(parameters('actionGroupIdSev0')), createArray(), createArray(parameters('actionGroupIdSev0')))]",
    "actionGroupsSev1": "[if(empty(parameters('actionGroupIdSev1')), createArray(), createArray(parameters('actionGroupIdSev1')))]",
    "actionGroupsSev2": "[if(empty(parameters('actionGroupIdSev2')), createArray(), createArray(parameters('actionGroupIdSev2')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Syslog-Sev0-Emergency', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deploySev0Emergency')]",
      "properties": {
        "displayName": "[format('{0}-Syslog-Sev0-Emergency', parameters('alertNamePrefix'))]",
        "description": "AVSSyslog Severity emerg/emergency events",
        "severity": 0,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Severity in (\"emerg\", \"emergency\")\n| where not(AppName == \"NSX\" and (Message has \"Accepts incoming connection from TN\" or Message has \"Finishes fullsync with TN\" or Message has \"Disconnected with TN\"))\n| where not(AppName == \"vmkbacktrace\" and Message has \"hostd-live\")\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev0')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Syslog-Sev0-Alert', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deploySev0Alert')]",
      "properties": {
        "displayName": "[format('{0}-Syslog-Sev0-Alert', parameters('alertNamePrefix'))]",
        "description": "AVSSyslog Severity alert events (excludes recoverable NSX failure-domain heartbeat chatter, NSX EAM service flapping, and Microsoft-managed sudo expired-credential loops; sustained outages are caught by the dedicated AVS-Event-NSX-FailureDomainDown / NSX-EAMServiceDown / Host-SudoExpiredCredential alerts)",
        "severity": 0,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Severity == \"alert\"\n| where not(AppName == \"NSX\" and Message has \"failure domain\" and Message has_any (\"are down\", \"are reachable\"))\n| where not(AppName == \"NSX\" and Message has \"ESX Agent Manager (EAM) service\" and Message has_any (\"is down\", \"is either up\"))\n| where not(AppName == \"sudo\" and Message has_any (\"Account or password is expired\", \"unable to change expired password\", \"Authentication token manipulation error\"))\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev0')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Syslog-Sev1-Critical', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deploySev1Critical')]",
      "properties": {
        "displayName": "[format('{0}-Syslog-Sev1-Critical', parameters('alertNamePrefix'))]",
        "description": "AVSSyslog Severity crit/critical events",
        "severity": 1,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Severity in (\"crit\", \"critical\")\n| where not(AppName == \"vsand\" and Message has \"CalculateHostStats\")\n| where not(AppName in (\"clomd\", \"clomd-whatif\"))\n| where not(AppName == \"etcd\" and Message has \"purge snap\")\n| where AppName != \"esxcli\"\n| where not(AppName == \"NSX\" and Message has \"should resolve to the same FQDN\")\n| where not(AppName == \"NSX\" and Message has \"failure domain\" and (Message has \"are down\" or Message has \"are reachable\"))\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev1')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Syslog-Sev2-Error', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deploySev2Error')]",
      "properties": {
        "displayName": "[format('{0}-Syslog-Sev2-Error', parameters('alertNamePrefix'))]",
        "description": "AVSSyslog Severity err/error above threshold",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[concat('AVSSyslog\n| where Severity in (\"err\", \"error\")\n| summarize ErrorCount = count() by HostName, AppName, bin(TimeGenerated, 15m)\n| where ErrorCount > ', string(parameters('errThresholdPer15m')))]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev2')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-Host-ConnectionLost', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployHostConnectionLost')]",
      "properties": {
        "displayName": "[format('{0}-Event-Host-ConnectionLost', parameters('alertNamePrefix'))]",
        "description": "One or more hosts lost connection to vCenter and did not reconnect within 5 minutes. Bursts (e.g. vCenter restart) are collapsed into a single 1-minute window so each row = one event with HostsAffected count, sample hosts, and longest outage. Transient blips and Fdm peer chatter are excluded.",
        "severity": 0,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "let window = 15m;\nlet lookahead = 10m;\nAVSSyslog\n| where TimeGenerated > ago(window + lookahead)\n| where AppName == \"vpxd\"\n| where Message has_any (\"HostConnectionLostEvent\", \"HostConnectedEvent\")\n| extend EventType = case(Message has \"HostConnectionLostEvent\", \"Lost\", Message has \"HostConnectedEvent\", \"Conn\", \"\")\n| extend Host = case(EventType == \"Lost\", extract(@\"Host (\\S+) in\", 1, Message), EventType == \"Conn\", extract(@\"Connected to (\\S+) in\", 1, Message), \"\")\n| where Host != \"\"\n| sort by Host asc, TimeGenerated asc\n| extend NextType = next(EventType), NextTime = next(TimeGenerated), NextHost = next(Host)\n| where EventType == \"Lost\"\n| where TimeGenerated > ago(window)\n| extend RecoveredAfter = iff(NextHost == Host and NextType == \"Conn\", NextTime - TimeGenerated, timespan(null))\n| where isnull(RecoveredAfter) or RecoveredAfter > 5m\n| summarize HostsAffected = dcount(Host), SampleHosts = tostring(make_set(Host, 10)), MaxRecoveredAfter = max(RecoveredAfter) by BurstTime = bin(TimeGenerated, 1m)\n| where HostsAffected > 0\n| project BurstTime, HostsAffected, SampleHosts, MaxRecoveredAfter",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev0')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-Host-Shutdown', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployHostShutdown')]",
      "properties": {
        "displayName": "[format('{0}-Event-Host-Shutdown', parameters('alertNamePrefix'))]",
        "description": "Host shutdown event",
        "severity": 0,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has \"hostshutdownevent\"\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev0')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-VM-Disconnected', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployVmDisconnected')]",
      "properties": {
        "displayName": "[format('{0}-Event-VM-Disconnected', parameters('alertNamePrefix'))]",
        "description": "VM disconnected event",
        "severity": 1,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has \"vmdisconnectedevent\"\n| where not(Message has \"com.vmware.vsan.health\")\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev1')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-VM-RemovedFromInventory', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployVmRemovedFromInventory')]",
      "properties": {
        "displayName": "[format('{0}-Event-VM-RemovedFromInventory', parameters('alertNamePrefix'))]",
        "description": "VM removed from inventory event",
        "severity": 1,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has \"vmremovedevent\"\n| where not(Message has \"com.vmware.vsan.health\")\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev1')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-VM-GuestReboot', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployVmGuestReboot')]",
      "properties": {
        "displayName": "[format('{0}-Event-VM-GuestReboot', parameters('alertNamePrefix'))]",
        "description": "VM guest reboot event",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has \"VmGuestRebootEvent\"\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev2')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-DNS-Failures', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployDnsFailures')]",
      "properties": {
        "displayName": "[format('{0}-Event-DNS-Failures', parameters('alertNamePrefix'))]",
        "description": "DNS failure threshold exceeded",
        "severity": 1,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[concat('AVSSyslog\n| where AppName == \"dnsmasq\"\n| where Message has \"Failed DNS Query\"\n| summarize FailureCount = count() by HostName, bin(TimeGenerated, 15m)\n| where FailureCount > ', string(parameters('dnsFailureThresholdPer15m')))]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev1')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-NSX-DFW-BlockedSpike', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployDfwSpike')]",
      "properties": {
        "displayName": "[format('{0}-Event-NSX-DFW-BlockedSpike', parameters('alertNamePrefix'))]",
        "description": "Distributed firewall blocked traffic spike",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[concat('AVSSyslog\n| where AppName == \"FIREWALL\" or ProcId == \"FIREWALL\"\n| where Message has_any (\"DROP\", \"REJECT\", \"denied\")\n| summarize BlockedCount = count() by HostName, bin(TimeGenerated, 15m)\n| where BlockedCount > ', string(parameters('dfwSpikeThresholdPer15m')))]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev2')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-Host-MaintenanceMode', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployHostMaintenanceMode')]",
      "properties": {
        "displayName": "[format('{0}-Event-Host-MaintenanceMode', parameters('alertNamePrefix'))]",
        "description": "Host maintenance mode enter/exit events",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has_any (\"The host has entered maintenance mode\", \"The host has exited maintenance mode\")\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev2')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-Security-RoleChange', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployRolePermissionChanges')]",
      "properties": {
        "displayName": "[format('{0}-Event-Security-RoleChange', parameters('alertNamePrefix'))]",
        "description": "Role/permission change events (Role/Permission Added/Updated/Removed)",
        "severity": 1,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "AVSSyslog\n| where Message has_any (\"RoleAddedEvent\", \"RoleUpdatedEvent\", \"RoleRemovedEvent\", \"PermissionAddedEvent\", \"PermissionUpdatedEvent\", \"PermissionRemovedEvent\")\n| project TimeGenerated, HostName, AppName, Facility, Severity, Message",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[variables('actionGroupsSev1')]"
        },
        "autoMitigate": true
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-Event-NSX-FailureDomainDown', parameters('alertNamePrefix'))]",
      "location": "[parameters('location')]",
      "condition": "[parameters('deployNsxFailureDomainDown')]",
      "properties": {
        "displayName": "[format('{0}-Event-NSX-FailureDomainDown', parameters('alertNamePrefix'))]",
        "description": "One or more NSX failure domains went down and did not return reachable within 5 minutes. Bursts (e.g. mgmt-plane event) are collapsed into a single 1-minute window so each row = one event with FDsAffected count, sample failure domains, and longest outage. Transient NSX manager heartbeat blips are excluded.",
        "severity": 0,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "scopes": [
          "[parameters('workspaceResourceId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "let window = 15m;\nlet lookahead = 10m;\nAVSSyslog\n| where TimeGenerated > ago(window + lookahead)\n| where AppName == \"NSX\"\n| where Message has \"failure domain\" and Message has_any (\"are down\", \"are reachable\")\n| extend State = case(Message has \"are down\", \"Down\", Message has \"are reachable\", \"Up\", \"\")\n| extend FD = extract(@\"failure domain ([0-9a-f-]+)\", 1, Message)\n| where State != \"\" and FD != \"\"\n| sort by FD asc, TimeGenerated asc\n| extend NextState = next(State), NextTime = next(TimeGenerated), NextFD = next(FD)\n| where State == \"Down\"\n| where TimeGenerated > ago(window)\n| extend RecoveredAfter = iff(NextFD == FD and NextState == \"Up\", NextTime - TimeGenerated, timespan(null))\n| where isnull(RecoveredAfter) or RecoveredAfter > 5m\n| summarize FDsAffected = dcount(FD), SampleFDs = tostring(make_set(FD, 10)), MaxRecoveredAfter = max(RecoveredAfter) by BurstTime = bin(TimeGenerated, 1m)\n| where FDsAffected > 0\n| project BurstTime, FDsAffected, SampleFDs, MaxRecoveredAfter",
